# Env cho docker compose ở production. Copy thành infra/.env rồi sửa.
#
#   cp infra/.env.example infra/.env
#
# File này KHÁC apps/web/.env (bản dev, DB chạy trên máy). Compose chỉ đọc
# infra/.env, còn apps/web/.env không bao giờ vào image (xem .dockerignore).

# Mật khẩu Postgres. CHỈ DÙNG CHỮ VÀ SỐ: nó được nhét vào DATABASE_URL, mà ký
# tự như @ : / ? trong URL phải percent-encode. Sinh nhanh:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Hai domain, PHẢI KHÁC HOSTNAME nhau, không phải khác port. Cookie phiên là
# host-only trên APP_DOMAIN nên không lọt sang PLAYER_DOMAIN — đó là thứ giữ
# cho game do người lạ upload không đọc được session của trẻ đang đăng nhập.
#
# Cả hai phải trỏ A/AAAA về IP của VPS TRƯỚC KHI `docker compose up`, không thì
# Caddy xin chứng chỉ thất bại.
#
# Khai ở đây một lần là đủ: Caddyfile đọc lại qua biến môi trường.
APP_DOMAIN=app.kidogame.vn
PLAYER_DOMAIN=play.kidogame.vn

# Địa chỉ Let's Encrypt dùng để cảnh báo chứng chỉ sắp hết hạn.
ADMIN_EMAIL=admin@kidogame.vn

# --- Sao lưu ---------------------------------------------------------------
# Nơi chứa bản sao lưu TRÊN HOST. Mặc định là infra/backups.
#
# Để mặc định thì bản sao lưu nằm CÙNG Ổ ĐĨA với dữ liệu gốc — chống được lỡ tay
# xoá, KHÔNG chống được ổ đĩa chết. Trỏ sang ổ khác, hoặc rsync thư mục này sang
# máy khác, mới gọi là có backup thật.
BACKUP_HOST_DIR=./backups

# Giữ lại bao nhiêu bản mỗi loại (db và storage tính riêng).
BACKUP_KEEP=7

# Giờ chạy hằng ngày, 0–23, theo giờ của container (UTC nếu không đặt TZ).
BACKUP_HOUR=3

# Gửi mail xác minh và đặt lại mật khẩu. BẮT BUỘC ở production: thiếu key thì
# src/lib/mail.ts ném lỗi thay vì in mail ra log, vì log production chứa token
# là rò token. Lấy key ở https://resend.com
RESEND_API_KEY=
MAIL_FROM=KidoGame <no-reply@kidogame.vn>
