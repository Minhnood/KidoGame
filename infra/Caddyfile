# Caddyfile cho production.
#
# Đây là bản tương ứng của infra/player-server.mjs (bản dev). Hai file này PHẢI
# giữ cùng một bộ header — nếu sửa một bên thì sửa cả bên kia, vì bộ e2e chỉ
# kiểm được bản dev.
#
# Điểm cốt lõi: HAI DOMAIN RIÊNG. File của người dùng không bao giờ được serve
# từ app origin. Cookie phiên là host-only trên app domain nên không lọt sang
# player domain.
#
# Domain đọc từ biến môi trường, KHÔNG viết cứng ở đây: docker compose truyền
# APP_DOMAIN/PLAYER_DOMAIN từ infra/.env vào cả file này và app, nên hai bên
# không thể lệch nhau. Lệch là frame-ancestors không khớp app origin, iframe bị
# chặn, và triệu chứng lại là "game không boot" — nhìn y hệt lỗi đóng gói.
# Giá trị sau dấu `:` là mặc định khi chạy Caddy tay, không qua compose.

{
	email {$ADMIN_EMAIL:admin@kidogame.vn}
}

# ---------------------------------------------------------------------------
# App origin — Next.js. Là nơi DUY NHẤT có cookie phiên.
# ---------------------------------------------------------------------------
{$APP_DOMAIN:app.kidogame.vn} {
	encode zstd gzip

	# TRẦN BODY — body lớn CHỈ cho hai đường nhận file, mọi đường khác tối đa 1MB.
	#
	# Middleware của Next đọc cả body của MỌI request vào bộ nhớ, tới
	# `middlewareClientMaxBodySize` (55MB, next.config.ts). Không chặn ở đây thì ai cũng
	# bắt được server giữ 55MB cho mỗi request tới bất kỳ đường nào. Hai đường upload cần
	# 55MB vì game .sb3 được tới 50MB (`LIMITS.MAX_SB3_BYTES`) cộng vỏ multipart; form lớn
	# nhất còn lại của app là ô chữ 2.000 ký tự, và `/api/upload/dang` chỉ gửi JSON.
	# Vượt trần thì Caddy trả 413 trước khi request tới app.
	# `caddy-config-check` đối chiếu các con số này với app.
	@nhanFile path /api/upload /api/upload/bia
	request_body @nhanFile {
		max_size 55MB
	}
	@khongNhanFile not path /api/upload /api/upload/bia
	request_body @khongNhanFile {
		max_size 1MB
	}

	# UMAMI — CHỈ HAI ĐƯỜNG, và đó là cả điểm của khối này.
	#
	# Thẻ script trong layout tải `/_stats/script.js` và gửi lượt xem về
	# `/_stats/api/send`. Cả hai nằm trên chính app domain, nên CSP của app
	# (`script-src 'self'` + nonce, `connect-src 'self'`) KHÔNG phải mở thêm host nào.
	#
	# Không proxy nguyên `/_stats/*`: làm vậy là bày luôn trang đăng nhập và API quản
	# trị của Umami ra app domain — nơi trẻ em dùng, và nơi cookie phiên của KidoGame
	# sống. Dashboard nằm ở STATS_DOMAIN riêng bên dưới.
	@umami path /_stats/script.js /_stats/api/send
	handle @umami {
		uri strip_prefix /_stats
		reverse_proxy umami:3000 {
			# Cùng lý do ghi đè như khối web ngay dưới: Umami băm IP này vào mã phiên
			# và đoán quốc gia từ nó, nên nó phải là IP thật chứ không phải chuỗi do
			# client tự viết.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# `handle` bọc ngoài thì mọi đường còn lại mới đi tới web — hai khối `handle`
	# loại trừ nhau, cái khớp trước thắng. Để `reverse_proxy web` trần ngoài `handle`
	# thì thứ tự chạy do Caddy tự sắp, không phải do thứ tự dòng trong file.
	handle {
		reverse_proxy web:3000 {
			# GHI ĐÈ X-Forwarded-For, không để Caddy nối thêm.
			#
			# Mặc định Caddy NỐI IP thật vào cuối chuỗi client gửi lên, nên phần tử
			# trái nhất là do client tự viết. Mà `clientIp()` trong src/lib/actions.ts
			# lấy đúng phần tử trái nhất — tức là IP hoàn toàn giả được bằng một dòng
			# header. Cái đó nuôi hạn mức 5 yêu cầu gỡ bản quyền mỗi IP mỗi ngày, mà
			# gửi yêu cầu là game của một đứa trẻ bị ẩn ngay lập tức.
			#
			# Ở đây Caddy là hop DUY NHẤT trước app (không Cloudflare, không LB), nên
			# ghi đè là đúng: không có proxy hợp lệ nào phía trước để mà giữ chuỗi.
			# Thêm một lớp proxy phía trước thì PHẢI sửa lại dòng này, không thì mọi
			# người dùng trông như cùng một IP.
			header_up X-Forwarded-For {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	# CSP do Next tự đặt trong next.config.ts để dev và prod dùng chung một nguồn.
}

# ---------------------------------------------------------------------------
# Admin origin — ORIGIN THỨ BA. Cùng ứng dụng, cookie khác, host khác.
#
# VÌ SAO CẦN MỘT HOSTNAME RIÊNG chứ không phải một đường dẫn trên app domain:
# cookie phiên quản trị là host-only trên host này, nên trình duyệt KHÔNG gửi nó tới
# app domain, và mã JavaScript chạy trên app domain không đọc được nó — hai origin
# khác nhau thì không chạm được cookie jar của nhau.
#
# Điều đó bảo vệ đúng một đường tấn công cụ thể: app domain render tên game và mô tả
# do TRẺ EM nhập, nên đó là chỗ XSS đáng lo nhất của cả dự án. Trước khi tách, một
# lỗ XSS ở đó đọc được phiên quản trị và POST được tới các server action ẩn game, gỡ
# hẳn, khoá tài khoản. Cookie không phân biệt theo PORT, nên "một cổng khác" không
# thay được "một hostname khác" — cùng lý lẽ đã ghi cho player origin.
#
# Cùng upstream `web:3000`: middleware của app quyết định host nào phục vụ đường dẫn
# nào, nên không cần container thứ hai. Trên host này mọi đường dẫn ngoài `/admin*`
# trả 404, kể cả `/game/<id>` — không thì origin đang giữ cookie quản trị lại render
# nội dung do trẻ nhập, tức là dựng rào rồi mở cổng.
#
# ĐỂ TRỐNG ADMIN_DOMAIN trong infra/.env là TẮT khu quản trị trên bản triển khai:
# site này nhận tên `admin.localhost` mà không DNS công cộng nào trỏ tới, còn app thì
# thấy ADMIN_ORIGIN rỗng và giữ hành vi cũ (/admin nằm trên app domain). Muốn tách
# thật thì phải khai cả ADMIN_DOMAIN ở đây và trỏ DNS về cùng IP.
#
# Cái tên thay thế đó do docker-compose.yml đặt, KHÔNG phải do mặc định sau dấu `:`
# dưới đây: mặc định của Caddy chỉ áp dụng khi biến CHƯA ĐƯỢC ĐẶT, mà compose thì
# đặt-thành-rỗng. Đặt-mà-rỗng ra một khối site KHÔNG CÓ TÊN, và Caddy từ chối cả file
# — tức là để trống một biến "tuỳ chọn" giết luôn app và player. Xem ghi chú dài ở
# docker-compose.yml trước khi đụng vào một trong hai chỗ.
# ---------------------------------------------------------------------------
{$ADMIN_DOMAIN:admin.kidogame.vn} {
	encode zstd gzip

	# Khu quản trị không nhận file nào. Cùng lý do trần body như app domain.
	request_body {
		max_size 1MB
	}

	reverse_proxy web:3000 {
		# Cùng lý lẽ ghi đè như app domain: Caddy là hop duy nhất trước app, nên
		# giữ chuỗi client gửi lên là để client tự khai IP của mình.
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# Khu quản trị KHÔNG BAO GIỜ được nhúng vào iframe của ai.
		X-Frame-Options "DENY"
		# `no-referrer` chặt hơn app domain (`same-origin`): đường dẫn ở đây mang id
		# game đang bị khiếu nại và id nhóm lỗi, và không có lý gì để chúng rời khỏi
		# đây khi người quản trị bấm một link ra ngoài.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}

# ---------------------------------------------------------------------------
# DASHBOARD UMAMI — chỉ người vận hành vào, nên ở một hostname riêng.
#
# Hostname riêng chứ không phải `app/_stats/`: trang đăng nhập và API quản trị của
# Umami không được nằm chung origin với trẻ em — cùng lý do khu quản trị KidoGame
# đã tách sang ADMIN_DOMAIN. Umami cũng không cho đổi đường gốc lúc chạy (BASE_PATH
# là biến lúc BUILD), nên đặt ở thư mục con thì phải tự build image.
#
# Để trống STATS_DOMAIN thì compose truyền `stats.localhost`: khối này vẫn hợp lệ
# nhưng không ai tới được — xem ghi chú ở ADMIN_DOMAIN trong docker-compose.yml.
# ---------------------------------------------------------------------------
{$STATS_DOMAIN:stats.kidogame.vn} {
	encode zstd gzip
	reverse_proxy umami:3000 {
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}

# ---------------------------------------------------------------------------
# DASHBOARD GLITCHTIP — theo dõi lỗi, chỉ người vận hành vào.
#
# Hostname riêng, cùng lý do với dashboard Umami ngay trên. Ở đây KHÔNG có đường nào
# mở trên app domain: chỉ server Next gửi lỗi, và nó gửi thẳng `glitchtip:8000`
# trong network nội bộ, không đi qua Caddy.
#
# Hệ quả: endpoint nhận lỗi `/api/<id>/envelope/` VẪN mở ở hostname này (GlitchTip
# không tách được). Ai có DSN thì gửi được lỗi rác vào — DSN chỉ nằm trong `.env`
# của server, không bao giờ xuống trình duyệt, nên đó là rủi ro chấp nhận được.
#
# Để trống ERRORS_DOMAIN thì compose truyền `loi.localhost` — xem ghi chú ở
# ADMIN_DOMAIN trong docker-compose.yml.
# ---------------------------------------------------------------------------
{$ERRORS_DOMAIN:loi.kidogame.vn} {
	encode zstd gzip
	reverse_proxy glitchtip:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}

# ---------------------------------------------------------------------------
# Player origin — chỉ file tĩnh. KHÔNG có ứng dụng, KHÔNG có cookie.
# ---------------------------------------------------------------------------
{$PLAYER_DOMAIN:play.kidogame.vn} {
	encode zstd gzip
	root * /srv/storage

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Tên file LÀ sha256 của nội dung -> nội dung không bao giờ đổi.
		Cache-Control "public, max-age=31536000, immutable"
		-Server
	}

	# --- HTML game đã đóng gói ---------------------------------------------
	# HTML này tự nhúng thẻ meta CSP rất lỏng (`default-src *`). Header dưới đây
	# vẫn có hiệu lực vì policy từ header và từ meta được áp dụng ĐỒNG THỜI,
	# kết quả là GIAO của hai policy.
	#
	# Runtime cần 'unsafe-inline'/'unsafe-eval' (compiler sinh JS lúc chạy) và
	# blob: (inline worker). Nhưng connect-src bị khoá nên game không gửi được
	# dữ liệu ra host nào khác.
	@html path /html/*
	header @html {
		Content-Type "text/html; charset=utf-8"
		Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:; form-action 'none'; frame-ancestors https://{$APP_DOMAIN:app.kidogame.vn}"
	}

	# --- File .sb3 gốc cho trẻ tải về ---------------------------------------
	# TUYỆT ĐỐI không để text/html ở đây.
	@sb3 path /sb3/*
	header @sb3 {
		Content-Type "application/octet-stream"
		Content-Disposition "attachment"
		Access-Control-Allow-Origin "*"
	}

	# --- Thumbnail ----------------------------------------------------------
	@thumb path /thumb/*
	header @thumb {
		Content-Type "image/webp"
		Access-Control-Allow-Origin "*"
	}

	# --- Runtime scratch-vm dùng chung cho mọi game -------------------------
	# Tách khỏi HTML để một đứa trẻ mở nhiều game không tải lại 1.75 MB mỗi lần.
	# Content-Type phải đúng: `nosniff` ở trên tắt việc trình duyệt tự đoán kiểu,
	# nên sai kiểu là trình duyệt từ chối chạy và game ra stage trắng.
	#
	# KHÔNG mở CORS ở đây: file này chỉ được nạp bằng thẻ <script> từ HTML nằm
	# trên chính origin này.
	@runtime path /runtime/*
	header @runtime {
		Content-Type "text/javascript; charset=utf-8"
	}

	# Chỉ cho phép đúng dạng đường dẫn địa chỉ-hoá-theo-nội-dung, chặn mọi thứ khác.
	#
	# Ghép cặp thùng-với-đuôi thay vì hai nhóm rời nhau: bản trước cho phép mọi tổ
	# hợp, tức `/html/<sha>.js` cũng là đường dẫn "hợp lệ" và nó nhận Content-Type
	# `text/html` từ khối @html ở trên. Chưa có file nào như thế nên chưa hại, nhưng
	# ràng buộc chặt hơn không tốn gì.
	@valid path_regexp ^/(sb3/[0-9a-f]{2}/[0-9a-f]{64}\.sb3|html/[0-9a-f]{2}/[0-9a-f]{64}\.html|thumb/[0-9a-f]{2}/[0-9a-f]{64}\.webp|runtime/[0-9a-f]{2}/[0-9a-f]{64}\.js)$
	handle @valid {
		file_server
	}
	handle {
		respond "404" 404
	}
}
