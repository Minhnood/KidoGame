# Caddyfile cho production.
#
# Đây là bản tương ứng của infra/player-server.mjs (bản dev). Hai file này PHẢI
# giữ cùng một bộ header — nếu sửa một bên thì sửa cả bên kia, vì bộ e2e chỉ
# kiểm được bản dev.
#
# Điểm cốt lõi: HAI DOMAIN RIÊNG. File của người dùng không bao giờ được serve
# từ app origin. Cookie phiên là host-only trên app domain nên không lọt sang
# player domain.
#
# Domain đọc từ biến môi trường, KHÔNG viết cứng ở đây: docker compose truyền
# APP_DOMAIN/PLAYER_DOMAIN từ infra/.env vào cả file này và app, nên hai bên
# không thể lệch nhau. Lệch là frame-ancestors không khớp app origin, iframe bị
# chặn, và triệu chứng lại là "game không boot" — nhìn y hệt lỗi đóng gói.
# Giá trị sau dấu `:` là mặc định khi chạy Caddy tay, không qua compose.

{
	email {$ADMIN_EMAIL:admin@kidogame.vn}
}

# ---------------------------------------------------------------------------
# App origin — Next.js. Là nơi DUY NHẤT có cookie phiên.
# ---------------------------------------------------------------------------
{$APP_DOMAIN:app.kidogame.vn} {
	encode zstd gzip

	reverse_proxy web:3000 {
		# GHI ĐÈ X-Forwarded-For, không để Caddy nối thêm.
		#
		# Mặc định Caddy NỐI IP thật vào cuối chuỗi client gửi lên, nên phần tử
		# trái nhất là do client tự viết. Mà `clientIp()` trong src/lib/actions.ts
		# lấy đúng phần tử trái nhất — tức là IP hoàn toàn giả được bằng một dòng
		# header. Cái đó nuôi hạn mức 5 yêu cầu gỡ bản quyền mỗi IP mỗi ngày, mà
		# gửi yêu cầu là game của một đứa trẻ bị ẩn ngay lập tức.
		#
		# Ở đây Caddy là hop DUY NHẤT trước app (không Cloudflare, không LB), nên
		# ghi đè là đúng: không có proxy hợp lệ nào phía trước để mà giữ chuỗi.
		# Thêm một lớp proxy phía trước thì PHẢI sửa lại dòng này, không thì mọi
		# người dùng trông như cùng một IP.
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	# CSP do Next tự đặt trong next.config.ts để dev và prod dùng chung một nguồn.
}

# ---------------------------------------------------------------------------
# Player origin — chỉ file tĩnh. KHÔNG có ứng dụng, KHÔNG có cookie.
# ---------------------------------------------------------------------------
{$PLAYER_DOMAIN:play.kidogame.vn} {
	encode zstd gzip
	root * /srv/storage

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Tên file LÀ sha256 của nội dung -> nội dung không bao giờ đổi.
		Cache-Control "public, max-age=31536000, immutable"
		-Server
	}

	# --- HTML game đã đóng gói ---------------------------------------------
	# HTML này tự nhúng thẻ meta CSP rất lỏng (`default-src *`). Header dưới đây
	# vẫn có hiệu lực vì policy từ header và từ meta được áp dụng ĐỒNG THỜI,
	# kết quả là GIAO của hai policy.
	#
	# Runtime cần 'unsafe-inline'/'unsafe-eval' (compiler sinh JS lúc chạy) và
	# blob: (inline worker). Nhưng connect-src bị khoá nên game không gửi được
	# dữ liệu ra host nào khác.
	@html path /html/*
	header @html {
		Content-Type "text/html; charset=utf-8"
		Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:; form-action 'none'; frame-ancestors https://{$APP_DOMAIN:app.kidogame.vn}"
	}

	# --- File .sb3 gốc cho trẻ tải về ---------------------------------------
	# TUYỆT ĐỐI không để text/html ở đây.
	@sb3 path /sb3/*
	header @sb3 {
		Content-Type "application/octet-stream"
		Content-Disposition "attachment"
		Access-Control-Allow-Origin "*"
	}

	# --- Thumbnail ----------------------------------------------------------
	@thumb path /thumb/*
	header @thumb {
		Content-Type "image/webp"
		Access-Control-Allow-Origin "*"
	}

	# --- Runtime scratch-vm dùng chung cho mọi game -------------------------
	# Tách khỏi HTML để một đứa trẻ mở nhiều game không tải lại 1.75 MB mỗi lần.
	# Content-Type phải đúng: `nosniff` ở trên tắt việc trình duyệt tự đoán kiểu,
	# nên sai kiểu là trình duyệt từ chối chạy và game ra stage trắng.
	#
	# KHÔNG mở CORS ở đây: file này chỉ được nạp bằng thẻ <script> từ HTML nằm
	# trên chính origin này.
	@runtime path /runtime/*
	header @runtime {
		Content-Type "text/javascript; charset=utf-8"
	}

	# Chỉ cho phép đúng dạng đường dẫn địa chỉ-hoá-theo-nội-dung, chặn mọi thứ khác.
	#
	# Ghép cặp thùng-với-đuôi thay vì hai nhóm rời nhau: bản trước cho phép mọi tổ
	# hợp, tức `/html/<sha>.js` cũng là đường dẫn "hợp lệ" và nó nhận Content-Type
	# `text/html` từ khối @html ở trên. Chưa có file nào như thế nên chưa hại, nhưng
	# ràng buộc chặt hơn không tốn gì.
	@valid path_regexp ^/(sb3/[0-9a-f]{2}/[0-9a-f]{64}\.sb3|html/[0-9a-f]{2}/[0-9a-f]{64}\.html|thumb/[0-9a-f]{2}/[0-9a-f]{64}\.webp|runtime/[0-9a-f]{2}/[0-9a-f]{64}\.js)$
	handle @valid {
		file_server
	}
	handle {
		respond "404" 404
	}
}
