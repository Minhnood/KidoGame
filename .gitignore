node_modules/
storage/
# Bản sao lưu: chứa dump DB đầy đủ, tức là email phụ huynh và hash mật khẩu.
# Lỡ commit một file ở đây là rò toàn bộ dữ liệu người dùng vào lịch sử git,
# nơi xoá đi cũng không mất.
backups/
# Khoá SSH của bước đẩy sao lưu ra ngoài máy. Giữ .gitkeep để thư mục vẫn tồn
# tại — compose mount ./ssh vào container, thiếu thư mục là service không lên.
infra/ssh/*
!infra/ssh/.gitkeep
.env
.env.local
.next/
dist/
*.log
*.tsbuildinfo
