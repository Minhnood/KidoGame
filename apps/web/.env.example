DATABASE_URL="postgresql://USER@localhost:5432/kidogame?schema=public"
STORAGE_DIR="../../storage"
# Origin riêng cho player. Dev dùng 127.0.0.1 (khác host với localhost) để cookie
# thật sự cách ly — cookie KHÔNG phân biệt theo port, nên đổi port là không đủ.
PLAYER_ORIGIN="http://127.0.0.1:3001"

# Origin của chính app. Dùng để dựng link tuyệt đối trong email (xác minh email,
# đặt lại mật khẩu). Sai biến này thì link trong mail trỏ về nhầm chỗ.
APP_ORIGIN="http://localhost:3000"

# Gửi mail. ĐỂ TRỐNG HẾT khi dev: mail sẽ được in ra console server và bày ở
# /dev/thu thay vì gửi đi thật, nên thử được toàn bộ luồng mà không cần tài khoản
# nào và không sợ lỡ tay gửi cho người thật.
#
# Có hai đường gửi thật, chọn MỘT. Đặt cả hai thì SMTP thắng.
#
# ĐƯỜNG 1 — SMTP, gửi qua hòm thư sẵn có, KHÔNG cần domain riêng. Đây là đường
# nhanh nhất để mail đi thật được. Với Gmail: bật xác minh hai bước rồi tạo App
# Password ở https://myaccount.google.com/apppasswords và dán vào SMTP_PASS —
# KHÔNG dùng mật khẩu đăng nhập Gmail, Google chặn thẳng.
#
# MAIL_FROM nên trùng SMTP_USER: Gmail viết lại người gửi thành địa chỉ đã xác
# thực, nên khai lệch chỉ làm mình đọc log rồi tưởng thư đi từ chỗ khác.
#
# Đặt SMTP_* ở máy dev vẫn an toàn cho bộ kiểm: từ nay mail vẫn luôn được in ra
# log ở dev, kể cả khi đã gửi thật.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Chỉ đặt khi máy chủ không theo quy ước 465 = TLS ngay, 587 = STARTTLS.
SMTP_SECURE=""

# ĐƯỜNG 2 — Resend, HTTP API. Cần domain riêng đã verify mới gửi được cho người
# ngoài; chưa có domain thì Resend chỉ cho gửi tới chính hòm thư chủ tài khoản.
RESEND_API_KEY=""

MAIL_FROM="KidoGame <no-reply@kidogame.local>"

# Ai đứng sau trang web. Hiện trên /dieu-khoan, và là nơi nhận mail mỗi khi có
# yêu cầu gỡ bản quyền. Để trống khi dev cũng chạy được — trang điều khoản chỉ
# hiện thêm một dòng cảnh báo là chưa cấu hình.
#
# Ở production thì khai trong infra/.env chứ không phải file này.
OPERATOR_NAME=""
OPERATOR_EMAIL=""
