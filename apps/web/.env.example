DATABASE_URL="postgresql://USER@localhost:5432/kidogame?schema=public"
STORAGE_DIR="../../storage"
# Origin riêng cho player. Dev dùng 127.0.0.1 (khác host với localhost) để cookie
# thật sự cách ly — cookie KHÔNG phân biệt theo port, nên đổi port là không đủ.
PLAYER_ORIGIN="http://127.0.0.1:3001"

# Origin của chính app. Dùng để dựng link tuyệt đối trong email (xác minh email,
# đặt lại mật khẩu). Sai biến này thì link trong mail trỏ về nhầm chỗ.
APP_ORIGIN="http://localhost:3000"

# Gửi mail. ĐỂ TRỐNG khi dev: mail sẽ được in ra console server thay vì gửi đi
# thật, nên thử được toàn bộ luồng mà không cần API key và không sợ lỡ tay gửi
# cho người thật. Ở production mà thiếu RESEND_API_KEY thì việc gửi sẽ ném lỗi —
# cố ý, vì in mail chứa token ra log production là rò token.
RESEND_API_KEY=""
MAIL_FROM="KidoGame <no-reply@kidogame.local>"
