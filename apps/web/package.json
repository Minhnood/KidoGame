{
  "name": "@kidogame/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "player": "node ../../infra/player-server.mjs",
    "db:push": "prisma db push && pnpm db:constraints",
    "db:deploy": "prisma db push --skip-generate && pnpm db:constraints",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-search": "tsx prisma/backfill-search.ts",
    "typecheck": "tsc --noEmit",
    "db:constraints": "node prisma/apply-constraints.mjs"
  },
  "dependencies": {
    "@kidogame/sb3": "workspace:*",
    "@prisma/client": "^6.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}