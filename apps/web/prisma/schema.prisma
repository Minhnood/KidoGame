generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tài khoản duy nhất có email. Phụ huynh tự tạo tài khoản cho con,
/// nên chính hành động này là cơ chế đồng ý của người đại diện.
model Parent {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  /// Null nghĩa là chưa bấm link xác minh trong mail.
  ///
  /// CỐ TÌNH không chặn đăng nhập khi chưa xác minh: phụ huynh đăng ký xong là
  /// tạo tài khoản cho con ngay, chặn ở đây thì đứa trẻ ngồi chờ bố mẹ mở mail.
  /// Xác minh dùng để bảo đảm luồng quên-mật-khẩu gửi tới đúng hòm thư thật.
  emailVerifiedAt DateTime?

  children   Child[]
  reports    Report[]
  sessions   Session[]
  authTokens AuthToken[]
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Token dùng MỘT LẦN gửi qua email: xác minh email và đặt lại mật khẩu.
///
/// Giống Session, cột khoá chính là sha256 của token thật nằm trong link —
/// rò database KHÔNG kéo theo rò token, vì từ hash không dựng ngược lại được.
model AuthToken {
  tokenHash String       @id
  parentId  String
  purpose   TokenPurpose
  expiresAt DateTime
  /// Đánh dấu đã dùng thay vì xoá: còn nhìn thấy token vừa bị dùng lại lần hai.
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, purpose])
  @@index([expiresAt])
}

/// Tài khoản của trẻ: KHÔNG email, KHÔNG tên thật.
/// `username` do phụ huynh đặt, dùng để đăng nhập.
model Child {
  id           String   @id @default(cuid())
  parentId     String
  username     String   @unique
  displayName  String
  passwordHash String
  birthYear    Int?
  createdAt    DateTime @default(now())

  /// Phụ huynh khoá được tài khoản con mà không cần xoá.
  isLocked Boolean @default(false)

  parent    Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  games     Game[]
  sessions  Session[]
  reactions Reaction[]
  /// Vết kiểm duyệt nhắm vào chính TÀI KHOẢN này (admin khoá/mở khoá), không
  /// nhắm vào một game cụ thể.
  moderationLogs ModerationLog[]

  @@index([parentId])
}

/// Phiên đăng nhập lưu trong DB, KHÔNG dùng JWT.
///
/// Lý do: phụ huynh phải thu hồi được phiên của con ngay lập tức (khoá tài khoản,
/// đổi mật khẩu). JWT thì token đã phát ra không gọi về được, còn hàng ở đây thì
/// xoá là mất hiệu lực tức thì.
///
/// Đúng một trong hai cột parentId/childId được set — xem `CHECK` constraint
/// thêm bằng migration, Prisma không diễn đạt được ràng buộc này.
model Session {
  /// sha256 của token trong cookie. Rò database KHÔNG kéo theo rò phiên.
  tokenHash String   @id
  parentId  String?
  childId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Hash của IP + user agent, chỉ để phụ huynh nhận ra phiên lạ. Không lưu IP thô.
  clientHash String @default("")
  /// `SITE` cho phiên phụ huynh và bé, `ADMIN` cho phiên khu quản trị.
  ///
  /// VÌ SAO CẦN CỘT NÀY. Khu quản trị nằm trên origin riêng với cookie riêng, và
  /// điều đó chỉ có nghĩa nếu hai loại phiên KHÔNG dùng lẫn được. Không có cột này
  /// thì một token phiên phụ huynh, lấy được từ máy của chính họ rồi dán vào cookie
  /// admin, sẽ tra ra đúng một hàng Session hợp lệ — tức cả việc tách origin trở
  /// thành trang trí. Phiên phải biết nó được phát ra cho cửa nào.
  ///
  /// Mặc định `SITE`: hàng đã có từ trước là phiên site, và đó cũng là hướng an
  /// toàn — đoán sai kiểu này thì một phiên bị coi là ít quyền hơn thực tế.
  scope String @default("SITE")

  parent Parent? @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child  Child?  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([childId])
  @@index([expiresAt])
}

/// Đếm số lần đăng nhập sai để chặn dò mật khẩu.
///
/// Khoá theo (loại, danh tính) chứ không theo IP: trẻ trong cùng một lớp hay một
/// nhà sẽ dùng chung IP, khoá theo IP là khoá oan cả lớp.
model LoginAttempt {
  id          String   @id @default(cuid())
  /// "parent:<email>" hoặc "child:<username>", đã lowercase.
  identity    String   @unique
  failedCount Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

enum GameStatus {
  PUBLISHED

  /// Ẩn MỀM: rút khỏi trang chủ, tìm kiếm và mọi danh sách, nhưng link trực tiếp
  /// vẫn chơi được.
  ///
  /// Đây là hành động tự động khi đủ ngưỡng báo cáo, thay cho việc ẩn hẳn. Lý do:
  /// nội dung xấu bị chặn đúng thứ cần chặn là ĐƯỜNG LAN TRUYỀN — không ai còn tình
  /// cờ gặp nó nữa — trong khi một game bị vùi oan không biến mất trước mặt những
  /// người bạn mà bé đã gửi link cho. Hai loại thiệt hại không đối xứng: bỏ sót nội
  /// dung xấu vài giờ là tệ, nhưng xoá công của một đứa trẻ vì ba người lạ bấm nút
  /// cũng là tệ, và cái sau thì chính đứa trẻ đó phải chịu.
  ///
  /// Đủ ngưỡng gấp đôi thì mới lên HIDDEN. Xem `communityStatus` trong
  /// `src/lib/moderation.ts`.
  LIMITED

  HIDDEN
  REMOVED
}

model Game {
  id          String @id @default(cuid())
  childId     String
  title       String
  description String @default("")

  /// Bốn nội dung đều địa chỉ hoá theo nội dung — cùng sha256 thì dùng chung file.
  sb3Sha256   String
  sb3Size     Int
  htmlSha256  String
  thumbSha256 String

  /// Runtime scratch-vm mà HTML của game này trỏ tới, đã tách ra thành file riêng.
  ///
  /// Giống hệt nhau giữa mọi game đóng gói bởi cùng một bản packager, nên trên đĩa
  /// nó chỉ có một bản. Lưu cột này KHÔNG để phục vụ — HTML tự mang đường dẫn — mà
  /// để trả lời được câu "file runtime nào còn game nào dùng" lúc dọn đĩa sau này.
  ///
  /// Rỗng nghĩa là game đóng gói TRƯỚC bản tách runtime, tức HTML của nó vẫn nhúng
  /// nguyên 1.75 MB. Chạy `db:repackage` để đưa nó sang bản mới.
  runtimeSha256 String @default("")

  /// Mặc định PUBLISHED theo quyết định "public ngay".
  /// Đổi default sang HIDDEN là bật được chế độ duyệt-trước.
  status GameStatus @default(PUBLISHED)

  playCount   Int @default(0)

  /// MỌI báo cáo, kể cả của khách vãng lai. Dùng để admin thấy mức độ ồn ào.
  reportCount Int @default(0)

  /// Chỉ báo cáo của phụ huynh ĐÃ XÁC MINH EMAIL. Đây là con số duy nhất được phép
  /// tự động thay đổi trạng thái game.
  ///
  /// Vì sao phải là cột riêng chứ không dùng `reportCount`: khách vãng lai bị khoá
  /// trùng theo hash IP, nên một người có Wi-Fi + 4G + VPN là tự đủ ba báo cáo mà
  /// không cần rủ ai. Đếm kiểu đó thì "ngưỡng 3" thực chất chỉ đắt bằng ba địa chỉ
  /// IP. Đòi email đã xác minh biến giá đó thành ba hòm thư thật, khác hẳn về bậc.
  ///
  /// Trẻ và khách vẫn báo cáo được, vẫn vào hàng đợi admin — chỉ không tự kích hoạt.
  /// ĐÁNH ĐỔI ĐÃ BIẾT: hiện không có gì bắt phụ huynh xác minh email ngoài một
  /// banner nhắc, nên lớp tự động sẽ nổ ít hơn trước. Bù lại nó không còn bị lách
  /// bằng vài phút đổi mạng.
  trustedReportCount Int @default(0)

  /// Tên + mô tả đã bỏ dấu và về chữ thường, để tìm kiếm không dấu.
  ///
  /// Trẻ gõ "meo" phải ra "Mèo phiêu lưu". Dùng cột thay vì extension `unaccent`
  /// của Postgres để khỏi phải CREATE EXTENSION lúc dựng DB trên VPS.
  /// Xem `src/lib/search.ts`. Nhớ ghi lại cột này mỗi khi tên/mô tả đổi.
  ///
  /// KHÔNG đánh index: truy vấn là `LIKE '%...%'` nên btree không giúp được gì.
  /// Khi nào số game đủ lớn để thấy chậm thì chuyển sang pg_trgm.
  titleSearch String @default("")

  /// Từ analysis của packager — ảnh hưởng dung lượng runtime nhúng vào HTML.
  usesMusic Boolean @default(false)
  /// Sb3Warning[] trả về từ validate (biến đám mây, file bị strip...).
  warnings Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lúc game chuyển sang `REMOVED`. Null với mọi trạng thái khác.
  ///
  /// Cần một cột RIÊNG chứ không suy ra từ đâu khác, vì nó là đồng hồ của hạn xoá
  /// hẳn (7 ngày, xem `NGAY_GIU_GAME_DA_GO`). Hai nguồn có sẵn đều sai:
  /// `updatedAt` đổi theo mọi lần ghi — kể cả `playCount` — nên nó sẽ liên tục đẩy
  /// hạn xoá ra xa mỗi lần có người bấm vào link cũ; còn `ModerationLog` thì một
  /// game có thể bị gỡ rồi cho hiện lại rồi gỡ lần nữa, nên đọc log là phải tự
  /// quyết định lần nào mới tính, đúng thứ một cột trả lời được bằng một giá trị.
  ///
  /// Phải trả về NULL khi cho hiện lại. Không xoá thì game hiện lại vẫn mang hạn
  /// cũ, và bảy ngày sau nó bị xoá trong lúc đang chạy bình thường trên trang chủ.
  removedAt DateTime?

  child            Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  reports          Report[]
  moderationLogs   ModerationLog[]
  tags             GameTag[]
  takedownRequests TakedownRequest[]
  reactions        Reaction[]

  @@index([childId])
  @@index([status, createdAt])
  @@index([sb3Sha256])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id       String @id @default(cuid())
  gameId   String
  /// Null khi người report không đăng nhập.
  reporterParentId String?
  /// Lưu hash của IP chứ không lưu IP thô — đủ để chống spam, không thành PII dư thừa.
  reporterIpHash String
  reason         String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  game     Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reporter Parent? @relation(fields: [reporterParentId], references: [id], onDelete: SetNull)

  /// Một người chỉ report một game một lần.
  @@unique([gameId, reporterIpHash])
  @@index([status])
}

enum TakedownStatus {
  OPEN
  /// Khiếu nại đúng — game đã bị gỡ hẳn.
  ACCEPTED
  /// Khiếu nại không đúng — game được cho hiện lại (nếu chính nó gây ra việc ẩn).
  REJECTED
}

/// Yêu cầu gỡ game vì vi phạm bản quyền.
///
/// TÁCH KHỎI `Report` một cách có chủ đích, dù `Report` đã có lý do `CHEP_BAI`.
/// Hai thứ khác nhau ở người gửi và ở cái cần thu thập:
///
///  - `Report` là của người dùng trong nhà — thường là trẻ hoặc phụ huynh đi ngang
///    qua. Nó cố tình KHÔNG có ô nhập tự do, và chỉ cần đếm tới ngưỡng.
///  - Yêu cầu gỡ là của người NGOÀI, thường là tác giả bản gốc, không có tài khoản
///    ở đây. Cái cần là danh tính người khiếu nại và căn cứ sở hữu — chính hai thứ
///    mà form báo cáo cố tình không hỏi.
///
/// Không lưu cột "đã cam đoan trung thực": `submitTakedownRequest` từ chối mọi yêu
/// cầu chưa cam đoan, nên mọi hàng trong bảng đều đã cam đoan. Một cột luôn luôn
/// `true` không nói lên gì.
model TakedownRequest {
  id String @id @default(cuid())

  /// Null khi game đã bị xoá hẳn sau hạn giữ — xem `gameTitle` ngay dưới.
  gameId String?

  /// Tên game lúc nhận yêu cầu, chụp lại tại chỗ.
  ///
  /// VÌ SAO PHẢI CHỤP. Game bị gỡ hẳn sẽ bị xoá khỏi DB sau 7 ngày, và đây là bảng
  /// DUY NHẤT trong hệ thống mang nghĩa vụ pháp lý: nó ghi ai khiếu nại, căn cứ gì,
  /// và ta đã xử lý ra sao. Để `onDelete: Cascade` như trước thì việc dọn dữ liệu
  /// tự xoá luôn bằng chứng đã xử lý đúng khiếu nại — nghĩa là càng làm đúng (gỡ
  /// hẳn) thì càng mất hồ sơ. Nên khoá ngoại là `SetNull`, và tên game phải nằm
  /// ngay trong hàng này, không thì hàng còn lại chỉ nói "có người khiếu nại một
  /// game nào đó".
  gameTitle String @default("")

  /// Người khiếu nại tự khai. KHÔNG xác minh được — đó chính là lý do phải có
  /// bước admin xem lại, chứ không gỡ hẳn ngay khi nhận.
  claimantName  String
  claimantEmail String
  /// Căn cứ: quan hệ với bản gốc, link tới bản gốc, ngày đăng...
  evidence String

  status TakedownStatus @default(OPEN)

  /// CHÍNH yêu cầu này có phải là thứ đã chuyển game sang HIDDEN hay không.
  ///
  /// Cần để hoàn tác cho đúng. Game có thể đã bị ẩn từ trước vì lý do khác (phụ
  /// huynh tự ẩn, hoặc đủ ngưỡng báo cáo); bác bỏ khiếu nại mà cứ thế cho hiện
  /// lại thì sẽ lật luôn quyết định của người khác, vì một việc chẳng liên quan.
  didHide Boolean @default(false)

  /// Hash của IP người gửi. CHỈ dùng để đếm hạn mức chống spam — KHÔNG dùng làm
  /// danh tính. Khác hẳn `Report.reporterIpHash`, cột đó vừa chống spam vừa là khoá
  /// chống trùng, và ở đây làm vậy là sai: hai người khác nhau cùng một mạng công ty
  /// cùng khiếu nại thì người thứ hai bị nuốt yêu cầu trong im lặng.
  ipHash String

  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  /// Id của admin đã xử lý. Chuỗi thường, không phải khoá ngoại — giống `ModerationLog.actorId`.
  resolvedBy     String?
  resolutionNote String    @default("")

  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  /// Chống trùng theo EMAIL người khiếu nại, không theo IP: người khiếu nại tự khai
  /// danh tính, và chính danh tính đó mới là thứ "cùng một người" nghĩa là gì ở đây.
  /// Gửi lại thì im lặng coi như đã nhận, đúng cách `reportGame` xử lý báo cáo trùng.
  ///
  /// Với `gameId` null (game đã xoá) Postgres coi mọi hàng là khác nhau, nên ràng
  /// buộc này lặng lẽ hết tác dụng ở đó. Đúng ý: game không còn thì không còn gì để
  /// khiếu nại trùng, và hàng cũ chỉ nằm lại làm hồ sơ.
  @@unique([gameId, claimantEmail])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

/// Vết của mọi thao tác kiểm duyệt.
///
/// Nhắm vào ĐÚNG MỘT đối tượng: một game, hoặc một tài khoản trẻ. Trước đây
/// `gameId` là bắt buộc, nên việc admin khoá tài khoản một bé không để lại vết
/// nào — mà đó lại là thao tác nặng nhất trong cả hệ thống. Hai cột nullable
/// cộng một CHECK constraint là cách diễn đạt "một trong hai, không phải cả
/// hai": giống hệt `Session.parentId`/`childId`.
///
/// Ràng buộc đúng-một nằm trong `prisma/constraints.sql`, Prisma không diễn đạt
/// được. Chạy `pnpm db:constraints` sau mỗi `prisma db push`.
/// Sổ ghi những gì đã làm với game và tài khoản của một đứa trẻ.
///
/// Đúng MỘT trong hai cột gameId/childId được set — trừ `ADMIN_DELETE_FAMILY`, nơi
/// cả hai buộc phải null vì đối tượng của thao tác đó vừa bị xoá trong cùng
/// transaction. Ràng buộc ở `prisma/constraints.sql`, Prisma không diễn đạt được —
/// nên đọc riêng file này sẽ KHÔNG thấy nó, và nó chỉ nổ lúc ghi thật.
model ModerationLog {
  id String @id @default(cuid())

  /// Null khi thao tác nhắm vào tài khoản trẻ.
  gameId String?
  /// Null khi thao tác nhắm vào một game.
  childId String?

  /// Ai thao tác: parent id, admin id, hoặc "system" khi tự động ẩn theo ngưỡng.
  actorId String
  action  String
  note    String @default("")

  createdAt DateTime @default(now())
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  child     Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([childId])
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  label String
  games GameTag[]
}

model GameTag {
  gameId String
  tagId  String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
}

/// Một bé thả một icon lên một game. "Thích" KHÔNG phải bảng riêng — nó là icon
/// `tim` trong bảng này.
///
/// VÌ SAO GỘP THÍCH VÀO ĐÂY. Nút tim và hàng icon là cùng một cử chỉ: "mình thấy
/// game này thế nào". Tách hai bảng thì có hai con số phải hiển thị cạnh nhau, hai
/// đường ghi phải giữ đồng bộ, và trên màn hình trẻ con nhìn thấy hai thứ làm gần
/// như một việc. Một hàng icon, trong đó có trái tim, là câu trả lời gọn hơn.
///
/// VÌ SAO KHOÁ CHÍNH LÀ (gameId, childId) — MỘT icon mỗi bé mỗi game. Không phải
/// giới hạn cho vui: khoá chính ghép làm DB tự chặn, nên không có đường nào ở tầng
/// ứng dụng ghi ra hai hàng. Bấm lại đúng icon đang chọn là gỡ, bấm icon khác là
/// đổi. Cho thả nhiều icon thì một bé đủ sức tự đẩy game mình lên đầu bảng, và con
/// số đếm được thôi trả lời câu "bao nhiêu BẠN thích", chỉ còn trả lời "bao nhiêu
/// lần có người bấm".
///
/// VÌ SAO CHỈ BÉ, KHÔNG PHẢI PHỤ HUYNH. Con số này nói "mấy bạn thích game của con"
/// và nó chỉ giữ được nghĩa đó nếu người thả đều là bạn. Phụ huynh vẫn xem được số,
/// chỉ không thả được.
///
/// KHÔNG có cột đếm dồn trên `Game` như `playCount`. Hai cột đếm kia chỉ TĂNG, còn
/// icon thì gỡ ra được, nên cột dồn sẽ lệch dần mỗi lần có ai đổi ý — và lệch theo
/// hướng không ai phát hiện. Đếm bằng `groupBy` lúc đọc: với quy mô này là một truy
/// vấn, và nó không bao giờ sai.
model Reaction {
  gameId  String
  childId String

  /// Mã ngắn, KHÔNG lưu ký tự emoji: `tim`, `vui`, `bat-ngo`, `dep`, `gioi`.
  ///
  /// Lưu mã thì đổi hình vẽ sau này chỉ là sửa một bảng tra trong code, còn dữ liệu
  /// cũ vẫn đúng. Lưu thẳng emoji thì bộ ký tự đó khoá cứng vào database, và một
  /// emoji có nhiều cách mã hoá (biến thể màu da, ZWJ) nên hai hàng trông giống hệt
  /// nhau vẫn là hai chuỗi khác nhau. Danh sách mã hợp lệ ở `src/lib/phan-ung.ts`.
  icon String

  createdAt DateTime @default(now())

  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([gameId, childId])
  /// Đếm theo game (trang game, danh sách game) là truy vấn duy nhất chạy thường.
  @@index([gameId])
  /// Xoá một bé thì cascade phải tìm được hàng của bé đó mà không quét cả bảng.
  @@index([childId])
}

/// Lỗi xảy ra ở máy người dùng thật, GOM THEO NHÓM chứ không một dòng một lần.
///
/// Vì sao cần bảng này: `error.tsx` và `global-error.tsx` chỉ `console.error`, tức
/// lỗi nằm trong DevTools của người dùng và ta không bao giờ thấy. Còn lỗi phía
/// server thì vào log Docker mà không ai đọc. Nghĩa là hệ thống không có cách nào
/// biết mình đang hỏng ngoài việc tự mở web ra xem. Xem `infra/GIAM-SAT.md` mục 4.
///
/// Vì sao gom nhóm chứ không ghi từng lần: một lỗi trong vòng render lặp lại có thể
/// bắn hàng nghìn báo cáo trong vài giây. Ghi từng dòng thì bảng phình theo tốc độ
/// lỗi, mà thông tin thêm gần bằng không — cái admin cần là "lỗi gì, mấy lần, lần
/// cuối khi nào", chứ không phải một nghìn bản sao của cùng một stack.
///
/// KHÔNG lưu IP, KHÔNG lưu user agent đầy đủ, KHÔNG lưu nội dung form. Lưu lỗi mà
/// kéo theo dữ liệu cá nhân là tự tạo ra đúng vấn đề mà cả kiến trúc này đang tránh.
model ErrorLog {
  id String @id @default(cuid())

  /// Khoá gom nhóm: băm của (nguồn + đường dẫn + digest + thông điệp). Unique, nên
  /// `upsert` theo cột này là toàn bộ cơ chế gom — không cần đếm ở tầng ứng dụng.
  fingerprint String @unique

  /// `boundary` (error.tsx), `global` (global-error.tsx), hoặc `server`.
  source String

  /// Đường dẫn nơi lỗi xảy ra, ĐÃ CẮT query string và hash.
  ///
  /// Cắt là bắt buộc, không phải cho gọn: query string mang những thứ như
  /// `?game=<id>` hay token trong link xác minh email, và một bảng lỗi mà giữ token
  /// là một bảng lỗi phải bảo vệ như bảng mật khẩu.
  path String

  /// `digest` của Next — sợi dây DUY NHẤT nối một dòng ở đây với một dòng trong log
  /// server ở production, nơi thông điệp lỗi thật cố tình không được gửi xuống
  /// trình duyệt. Rỗng khi lỗi không có digest (lỗi thuần phía client).
  digest String @default("")

  /// Thông điệp lỗi, đã cắt ngắn. Ở production lỗi từ server component đã bị Next
  /// thay bằng câu chung, nên phần lớn giá trị ở đây là lỗi thuần client.
  message String @default("")

  /// Tên trình duyệt và số hiệu chính, ví dụ `Chrome 130`. Rút từ user agent Ở PHÍA
  /// SERVER rồi bỏ phần còn lại: đủ để thấy "lỗi này chỉ xảy ra trên Safari", mà
  /// không giữ được chuỗi dài dùng để lần ra một người.
  browser String @default("")

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Null nghĩa là chưa ai xem. Đánh dấu đã xử lý KHÔNG xoá dòng: lỗi quay lại thì
  /// `count` tiếp tục tăng, và so được lần cuối với lúc đánh dấu.
  resolvedAt DateTime?

  /// Bộ lọc mặc định của trang admin là "chưa xử lý, mới nhất trước".
  @@index([resolvedAt, lastSeenAt])
  @@index([lastSeenAt])
}

/// Người dùng tự viết ra để báo một chỗ hỏng.
///
/// VÌ SAO KHÔNG DÙNG CHUNG `ErrorLog`. Hai thứ khác bản chất, và trộn chúng làm hỏng
/// cả hai. `ErrorLog` là lỗi do MÁY sinh: gom nhóm theo `fingerprint`, cột `count`
/// tăng mỗi lần lỗi lặp lại, và câu hỏi của người trực là "lỗi nào xảy ra nhiều
/// nhất". Bảng này là lời một NGƯỜI viết một lần: không gom được (hai người viết hai
/// câu khác nhau về cùng một chỗ hỏng), `count` vô nghĩa, và nó có một thứ mà lỗi tự
/// động không bao giờ có — một người đang chờ được trả lời.
///
/// Trang `/error.tsx` từ trước đã nói với người dùng "gửi kèm mã này giúp tìm ra
/// nguyên nhân nhanh hơn", và `/admin/loi` viết như thể luồng ấy tồn tại — nhưng
/// không có đường nào để gửi ngoài email của đơn vị vận hành. Bảng này là đường đó.
model BugReport {
  id String @id @default(cuid())

  /// Người dùng tự gõ. Cắt ngắn ở tầng ứng dụng, xem `lib/bao-loi.ts`.
  moTa String

  /// Mã lỗi họ dán từ trang lỗi (chính là `digest` của Next). Rỗng khi họ báo một
  /// chỗ hỏng không kèm mã — phần lớn báo cáo sẽ như vậy, vì người ta báo "game
  /// không chạy" nhiều hơn là gặp một trang lỗi đỏ.
  maLoi String @default("")

  /// Trang họ đang ở, ĐÃ CẮT query string và hash — cùng lý do với `ErrorLog.path`:
  /// query string mang token trong link xác minh email, và một bảng giữ token là
  /// bảng phải bảo vệ như bảng mật khẩu.
  duongDan String @default("")

  /// Email để trả lời. TUỲ CHỌN, và rỗng là một câu trả lời hợp lệ: bắt điền email
  /// mới được báo lỗi thì người gặp lỗi ở đúng luồng đăng nhập sẽ bỏ đi.
  emailLienHe String @default("")

  /// Tên trình duyệt rút gọn Ở PHÍA SERVER, ví dụ `Chrome 130`. Cùng cách và cùng lý
  /// do với `ErrorLog.browser`: đủ để thấy "chỉ Safari mới hỏng", mà không giữ được
  /// chuỗi dài dùng để lần ra một người.
  browser String @default("")

  /// Băm của IP, để chặn spam. Không lưu IP thô.
  ipHash String @default("")

  createdAt DateTime @default(now())

  /// Null nghĩa là chưa ai xem. Đánh dấu đã xử lý KHÔNG xoá dòng — người trực cần
  /// đọc lại được mình đã trả lời gì cho ai.
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}
